# Copy to .env and adjust for the deployment environment.
TRADING_ENVIRONMENT=development
TRADING_TICK_BUFFER_PER_SYMBOL=10000
TRADING_CANDLE_BUFFER_PER_SERIES=10000
TRADING_ANALYTICS_STARTING_EQUITY=100000
TRADING_ANALYTICS_REPORTING_TIMEZONE=America/New_York
TRADING_RISK_PER_TRADE_FRACTION=0.01
TRADING_MAX_DAILY_LOSS_FRACTION=0.02
TRADING_MAX_CONSECUTIVE_LOSSES=3
TRADING_STOP_ATR_MULTIPLE=1.5
TRADING_TARGET_ATR_MULTIPLE=3
TRADING_TRAILING_STOP_ATR_MULTIPLE=1
TRADING_MINIMUM_RISK_REWARD=2
# Docker Compose sets these values to its postgres and redis services. For a local
# process, use localhost rather than the Docker service names.
TRADING_STORAGE_BACKEND=postgres
TRADING_DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
TRADING_REDIS_URL=redis://localhost:6379/0
# Use mock locally without credentials. Set both to alpaca after supplying
# the matching paper or live Alpaca credentials below.
TRADING_MARKET_DATA_PROVIDER=mock
TRADING_EXECUTION_PROVIDER=mock
TRADING_TRADING_MODE=paper
TRADING_ORDER_SUBMISSION_ENABLED=false
# Automated execution is disabled by default. Enable only after a paper-trading
# verification and provide the mode-specific confirmation value below.
TRADING_AUTOMATION_ENABLED=false
TRADING_SYMBOLS=AAPL
TRADING_WORKER_COUNT=2
TRADING_WORKER_QUEUE_SIZE=2000
TRADING_ATR_PERIOD=14
TRADING_EMA_FAST_PERIOD=12
TRADING_EMA_SLOW_PERIOD=26
TRADING_MAX_GROSS_EXPOSURE_FRACTION=0.80
TRADING_MINIMUM_CASH_RESERVE_FRACTION=0.10
TRADING_MAX_OPEN_POSITIONS=10
# Keep all Alpaca credentials out of source control. Paper and live accounts use different keys.
TRADING_ALPACA_API_KEY=
TRADING_ALPACA_API_SECRET=
# Required only when enabling real-money order submission:
# TRADING_LIVE_TRADING_CONFIRMATION=ENABLE_LIVE_TRADING
# TRADING_AUTOMATION_CONFIRMATION=ENABLE_PAPER_AUTOMATION
# Live automation requires both confirmation values, with:
# TRADING_AUTOMATION_CONFIRMATION=ENABLE_LIVE_AUTOMATION
